# ==============================================================================
# DreamBeesAI · Environment Configuration Template
# All values below are defaults or safe local placeholders.
# Copy this file to .env before starting the server.
# ==============================================================================

# Server & Network Configuration
AGENTBOX_PORT=3030
AGENTBOX_HOST=127.0.0.1
PORT=3030

# Data Storage & State Persistence
# Default: ~/.dreambeesai
# AGENTBOX_DATA_DIR=/path/to/custom/data/dir

# Container Runtime & Docker Settings
AGENTBOX_NAMESPACE=agentbox-local
AGENTBOX_IMAGE=dreambeesai/agentbox:v1
AGENTBOX_MAX_RUNNING=10
AGENTBOX_MAX_TOTAL=50

# Security & Authentication
# Replace with a cryptographically secure random string in production
AGENTBOX_ADMIN_KEY=change_me_to_a_secure_random_key_before_production
AGENTBOX_SESSION_TTL=86400

# Lifecycle & Policy Engine
AGENTBOX_IDLE_TIMEOUT_MINUTES=30
AGENTBOX_PROVISIONING_TIMEOUT_SECONDS=90
AGENTBOX_MAX_RECOVERY_RETRIES=3
AGENTBOX_GRACE_PERIOD_HOURS=168
AGENTBOX_RECONCILE_INTERVAL_MS=15000
AGENTBOX_MAX_CONCURRENT_JOBS=3
AGENTBOX_MAX_PER_TENANT=5

# Economic Rates & Accounting (USD)
AGENTBOX_RATE_STANDARD=0.05
AGENTBOX_RATE_POWER=0.10
AGENTBOX_RATE_TITAN=0.20
AGENTBOX_RATE_IDLE=0.01
AGENTBOX_RATE_STORAGE=0.10
AGENTBOX_RATE_NETWORK=0.01
AGENTBOX_DEFAULT_SPEND_LIMIT=50.00
