#!/bin/bash
set -euo pipefail

APP="${1:-terminal}"

case "$APP" in
  terminal) pattern='xfce4-terminal.Xfce4-terminal' ;;
  chrome) pattern='google-chrome.Google-chrome' ;;
  cursor) pattern='Cursor' ;;
  codex) pattern='OpenAI Codex' ;;
  claude) pattern='Claude Code' ;;
  agy) pattern='Google Antigravity' ;;
  hermes-agent) pattern='Hermes Agent' ;;
  openclaw) pattern='OpenClaw' ;;
  grok) pattern='Grok CLI' ;;
  muse) pattern='Muse Agent' ;;
  aider) pattern='Aider Chat' ;;
  *) pattern="$APP" ;;
esac

focus() {
  wmctrl -xa "$pattern" 2>/dev/null || wmctrl -Fa "$pattern" 2>/dev/null
}

if focus; then
  exit 0
fi

/opt/agentbox/launch-app "$APP" >"/tmp/launch-$APP.log" 2>&1 </dev/null &
app_pid=$!

for i in {1..40}; do
  if focus; then
    exit 0
  fi
  if ! kill -0 "$app_pid" 2>/dev/null; then
    exit 1
  fi
  sleep .1
done

exit 0
